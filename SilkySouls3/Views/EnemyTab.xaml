<UserControl x:Class="SilkySouls3.Views.EnemyTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:enums="clr-namespace:SilkySouls3.Enums"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:converters="clr-namespace:SilkySouls3.Converters"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:StringToVisibilityConverter x:Key="NullToVisibilityConverter" />
    </UserControl.Resources>
    <TabControl Margin="5">
        <TabItem Header="General">
    <StackPanel Margin="10">

        <Border BorderThickness="1" BorderBrush="#333" CornerRadius="3" Margin="0,0,0,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Global Enemy Options" FontWeight="Bold" Margin="5,5,0,5" />
                
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="5">
                    <CheckBox Content="No Death" IsChecked="{Binding IsAllNoDeathEnabled}" Margin="5,0,0,5" />
                    <CheckBox Content="No Damage" IsChecked="{Binding IsAllNoDamageEnabled}" Margin="5,0,0,5" />
                    <CheckBox Content="No Move" IsChecked="{Binding IsAllNoMoveEnabled}" Margin="5,0,0,5" />
                    <CheckBox Content="No Attack" IsChecked="{Binding IsAllNoAttackEnabled}" Margin="5,0,0,5" />
                    <CheckBox Content="Disable AI" IsChecked="{Binding IsAllDisableAiEnabled}" Margin="5,0,0,5" />

                </StackPanel>
                
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="5">
                    <CheckBox Content="All Repeat Action" IsChecked="{Binding IsAllRepeatActEnabled}" Margin="0,2" />
                    <CheckBox Content="Enemy Targeting View" IsChecked="{Binding IsTargetingViewEnabled}" Margin="0,2" />
                    <CheckBox Content="Draw Navigation Route" IsChecked="{Binding IsDrawNavigationEnabled}" Margin="0,2" />
                </StackPanel>
                
            </Grid>
        </Border>

        <Border BorderThickness="1" BorderBrush="#333" CornerRadius="3" Margin="0,0,0,5">
            <StackPanel Margin="5">
                <TextBlock Text="Cinder" FontWeight="Bold" Margin="0,0,0,5" />
                <Grid Margin="5,0,0,5">
                    <WrapPanel Orientation="Horizontal">
                        <Button Content="Sword" Margin="0,0,5,5" Padding="8,3" MinWidth="40"
                                IsEnabled="{Binding AreCinderOptionsEnabled}"
                                Command="{Binding SetCinderPhaseCommand}"
                                CommandParameter="{x:Static enums:CinderPhase.Sword}" />
                        <Button Content="Lance" Margin="0,0,5,5" Padding="8,3" MinWidth="40"
                                IsEnabled="{Binding AreCinderOptionsEnabled}"
                                Command="{Binding SetCinderPhaseCommand}"
                                CommandParameter="{x:Static enums:CinderPhase.Lance}" />
                        <Button Content="Curved" Margin="0,0,5,5" Padding="8,3" MinWidth="40"
                                IsEnabled="{Binding AreCinderOptionsEnabled}"
                                Command="{Binding SetCinderPhaseCommand}"
                                CommandParameter="{x:Static enums:CinderPhase.Curved}" />
                        <Button Content="Staff" Margin="0,0,5,5" Padding="8,3" MinWidth="40"
                                IsEnabled="{Binding AreCinderOptionsEnabled}"
                                Command="{Binding SetCinderPhaseCommand}"
                                CommandParameter="{x:Static enums:CinderPhase.Staff}" />
                        <Button Content="Gwyn" Margin="0,0,5,5" Padding="8,3" MinWidth="40"
                                IsEnabled="{Binding AreCinderOptionsEnabled}"
                                Command="{Binding SetCinderPhaseCommand}"
                                CommandParameter="{x:Static enums:CinderPhase.Gwyn}" />
                    </WrapPanel>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button Content="Cast Soulmass" Margin="0,0,0,3" Padding="8,3"
                                IsEnabled="{Binding AreCinderOptionsEnabled}"
                                Command="{Binding CastSoulmassCommand}" />
                        <Button Content="Remove Soulmass" Padding="8,3"
                                IsEnabled="{Binding AreCinderOptionsEnabled}"
                                Command="{Binding RemoveSoulmassCommand}" />
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="5,0,0,0">
                    <CheckBox Content="Lock Phase" Margin="0,0,10,0" VerticalAlignment="Center"
                              IsChecked="{Binding IsCinderPhasedLocked}" />
                    <CheckBox Content="No Stagger" Margin="0,0,10,0" VerticalAlignment="Center"
                              IsChecked="{Binding IsCinderNoStaggerEnabled}" />
                    <CheckBox Content="Endless Soulmass" Margin="0,0,10,0" VerticalAlignment="Center"
                              IsChecked="{Binding IsEndlessSoulmassEnabled}" />
                    <CheckBox Content="No Soulmass Remove on Stagger" VerticalAlignment="Center"
                              IsChecked="{Binding IsNoSoulmassRemoveOnStaggerEnabled}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border BorderThickness="1" BorderBrush="#333" CornerRadius="3">
            <StackPanel Margin="5">
                <TextBlock Text="Halflight" FontWeight="Bold" Margin="0,0,0,5" />
                <Grid Margin="5,0,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Text="Argo talk speed multiplier" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <xctk:DecimalUpDown Value="{Binding ArgoSpeedMultiplier}"
                                            Minimum="0.1"
                                            Maximum="10.0"
                                            Increment="0.5"
                                            FormatString="F1"
                                            Width="80"
                                            VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Content="Place Prism Stones"
                            Command="{Binding PlacePrismStonesCommand}"
                            IsEnabled="{Binding CanPlacePrismStones}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>


        <Grid Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderThickness="1" BorderBrush="#333" CornerRadius="3" Margin="0,5,0,5">
                <StackPanel Margin="5">
                    <TextBlock Text="Pontiff" FontWeight="Bold" Margin="0,0,0,5" />
                    <CheckBox Content="Prevent Clone Summon"
                              IsChecked="{Binding IsPontiffNoCloneEnabled}" Margin="5,0,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" BorderThickness="1" BorderBrush="#333" CornerRadius="3" Margin="0,5,0,5"
                    IsEnabled="{Binding AreOceirosOptionsEnabled}">
                <StackPanel Margin="5">
                    <TextBlock Text="Oceiros" FontWeight="Bold" Margin="0,0,0,5" />
                    <Button Content="Phase 2" Padding="8,3" Margin="5,0,0,0" HorizontalAlignment="Left"
                            Command="{Binding ForceOceirosPhaseTwoCommand}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" BorderThickness="1" BorderBrush="#333" CornerRadius="3" Margin="0,5,0,5"
                    IsEnabled="{Binding AreKingOfTheStormOptionsEnabled}">
                <StackPanel Margin="5">
                    <TextBlock Text="Nameless" FontWeight="Bold" Margin="0,0,0,5" />
                    <Button Content="Skip Phase 1" Padding="8,3" Margin="5,0,0,0" HorizontalAlignment="Left"
                            Command="{Binding SkipKingOfTheStormCommand}" />
                </StackPanel>
            </Border>

        </Grid>
        

        <Grid Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderThickness="1" BorderBrush="#333" CornerRadius="3" Margin="0,0,5,0"
                    IsEnabled="{Binding AreDsaOptionsEnabled}">
                <StackPanel Margin="5">
                    <TextBlock Text="DSA" FontWeight="Bold" Margin="0,0,0,5" />
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Left Side:" VerticalAlignment="Center"
                                   Margin="5,0,5,5" />
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  SelectedIndex="{Binding SelectedLeftButterflyAnimation}"
                                  Margin="0,0,0,5" Width="120" HorizontalAlignment="Left">
                            <ComboBoxItem Content="None" />
                            <ComboBoxItem Content="Small Meatballs" />
                            <ComboBoxItem Content="Laser" />
                            <ComboBoxItem Content="Big Meatball" />
                        </ComboBox>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Right Side:" VerticalAlignment="Center"
                                   Margin="5,0,5,0" />
                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  SelectedIndex="{Binding SelectedRightButterflyAnimation}"
                                  Width="120" HorizontalAlignment="Left">
                            <ComboBoxItem Content="None" />
                            <ComboBoxItem Content="Small Meatballs" />
                            <ComboBoxItem Content="Laser" />
                            <ComboBoxItem Content="Big Meatball" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" BorderThickness="1" BorderBrush="#333" CornerRadius="3">
                <StackPanel Margin="5">
                    <TextBlock Text="Deacons" FontWeight="Bold" Margin="0,0,0,5" />
                    <Button Content="Phase 2" Padding="8,3" Margin="0,0,0,5" HorizontalAlignment="Left"
                            IsEnabled="{Binding AreDeaconsOptionsEnabled}"
                            Command="{Binding DeaconsPhase2Command}" />
                    <Button Content="Phase 2 (Move deacons to other side)" Padding="8,3" Margin="0,0,0,5"
                            HorizontalAlignment="Left"
                            IsEnabled="{Binding AreDeaconsOptionsEnabled}"
                            Command="{Binding DeaconsPhase2WithMoveCommand}" />
                    <Button Content="Drop 10 skulls at fog" Padding="8,3" HorizontalAlignment="Left"
                            IsEnabled="{Binding CanDropDeaconSkulls}"
                            Command="{Binding DropDeaconSkullsCommand}" />
                </StackPanel>
            </Border>
        </Grid>

    </StackPanel>
        </TabItem>
        <TabItem Header="Boss Revives">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Grid.RowSpan="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Areas" Margin="0,0,0,5" />

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Areas}"
                             SelectedItem="{Binding SelectedArea}"
                             BorderThickness="1"
                             BorderBrush="#333">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Border"
                                                    Background="Transparent"
                                                    Padding="8,4">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Border" Property="Background"
                                                            Value="{StaticResource AccentBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Border" Property="Background"
                                                            Value="{StaticResource HoverBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>

                <TextBox Grid.Row="0" Grid.Column="1"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         HorizontalAlignment="Right"
                         Width="150"
                         Height="25"
                         VerticalAlignment="Center"
                         Margin="0,0,0,5">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="3" />
                        </Style>
                    </TextBox.Resources>

                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3">
                                <Grid>
                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  Focusable="false"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Hidden"
                                                  VerticalAlignment="Center"
                                                  Margin="5,0,0,0" />
                                    <TextBlock Text="Search bosses..."
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Left"
                                               Margin="5,0,0,0"
                                               Foreground="Gray"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition
                                                                Binding="{Binding Path=Text, RelativeSource={RelativeSource AncestorType=TextBox}}"
                                                                Value="" />
                                                            <Condition
                                                                Binding="{Binding Path=IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=TextBox}}"
                                                                Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="border" Property="BorderThickness" Value="1.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>

                <Grid Grid.Row="1" Grid.Column="1" Margin="10,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            BorderThickness="1"
                            BorderBrush="#333">
                        <ListView ItemsSource="{Binding AreaBosses}"
                                  SelectedItem="{Binding SelectedBoss}"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  BorderThickness="0">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="8,4" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border x:Name="Border"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        SnapsToDevicePixels="true">
                                                    <ContentPresenter
                                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                        Margin="{TemplateBinding Padding}"
                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Border" Property="Background"
                                                                Value="{StaticResource AccentBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Border" Property="Background"
                                                                Value="{StaticResource HoverBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding BossName}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Area}"
                                                   Foreground="#888888"
                                                   FontStyle="Italic"
                                                   Margin="10,0,0,0"
                                                   Visibility="{Binding DataContext.IsSearchActive,
                                           RelativeSource={RelativeSource AncestorType=UserControl},
                                           Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </Grid>

                <Border Grid.Row="2"
                        BorderThickness="1"
                        BorderBrush="#333"
                        CornerRadius="3"
                        Margin="0,10,0,0"
                        Grid.ColumnSpan="2">
                    <StackPanel Margin="10">

                        <StackPanel Orientation="Horizontal"
                                    Margin="10,0,0,5"
                                    Visibility="{Binding SelectedBossStatus,
                             Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock Text="Status: " FontWeight="SemiBold" FontSize="12" />
                            <TextBlock Text="{Binding SelectedBossStatus}" FontWeight="Bold" FontSize="12"
                                       Foreground="{Binding SelectedBossStatusColor}" />
                        </StackPanel>

                        <Grid Margin="10,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="Revive Boss"
                                    Command="{Binding ReviveBossCommand}"
                                    IsEnabled="{Binding AreOptionsEnabled}"
                                    Margin="0,2,20,2" />
                            <Button Grid.Column="1" Content="Revive Boss as First Encounter"
                                    Command="{Binding ReviveBossFirstEncounterCommand}"
                                    IsEnabled="{Binding AreOptionsEnabled}"
                                    Margin="0,2,20,2" />
                            <CheckBox Grid.Column="2" Content="Rest on Revive"
                                      IsChecked="{Binding IsRestOnReviveEnabled}"
                                      Margin="0,2" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>